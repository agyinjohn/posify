PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pos
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Cashiers can give at most this % discount on a sale; larger needs the owner
MAX_CASHIER_DISCOUNT_PCT=10
# Optional: product images. Leave blank to disable image upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used only by `npm run seed` to create the first owner account
SEED_OWNER_NAME=Owner
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=
